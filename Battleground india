public class FusionNetworkRunner : MonoBehaviour {
    public NetworkRunner runnerPrefab;
    void Start() {
        var runner = Instantiate(runnerPrefab);
        runner.ProvideInput = true;
        runner.StartGame(new StartGameArgs {
            GameMode = GameMode.AutoHostOrClient,
            SessionName = "BattleRoom",
            Scene = SceneManager.GetActiveScene().buildIndex,
            PlayerCount = 50
        });
    }
}using UnityEngine;
using Fusion;

public class PlayerNetwork : NetworkBehaviour {
    public float moveSpeed = 5f;
    public GameObject bulletPrefab;
    public Transform firePoint;
    private GameObject equippedGun;

    public override void FixedUpdateNetwork() {
        if (Object.HasInputAuthority) {
            Vector3 dir = new Vector3(Input.GetAxis("Horizontal"), 0, Input.GetAxis("Vertical"));
            transform.Translate(dir * moveSpeed * Runner.DeltaTime);
        }
    }

    public override void Render() {
        if (Object.HasInputAuthority && Input.GetButtonDown("Fire1")) RPC_Shoot();
    }

    [Rpc(RpcSources.InputAuthority, RpcTargets.All)]
    void RPC_Shoot() => Instantiate(bulletPrefab, firePoint.position, firePoint.rotation);

    public void EquipGun(GameObject gunPrefab) {
        if (equippedGun) Destroy(equippedGun);
        equippedGun = Instantiate(gunPrefab, firePoint);
    }
}using UnityEngine;
