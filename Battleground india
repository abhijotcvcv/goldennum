public class GlooWallManager : NetworkBehaviour {
    public GameObject glooWallPrefab;
    public Transform deployPoint;

    public override void Render() {
        if (Object.HasInputAuthority && Input.GetKeyDown(KeyCode.G)) {
            RPC_DeployWall(deployPoint.position, deployPoint.rotation);
        }
    }

    [Rpc(RpcSources.InputAuthority, RpcTargets.All)]
    void RPC_DeployWall(Vector3 pos, Quaternion rot) {
        Instantiate(glooWallPrefab, pos, rot);
    }
