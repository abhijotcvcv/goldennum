public class PlayerController : MonoBehaviour {
    public float speed = 5f, lookSpeed = 2f;
    private CharacterController cc;
    float yaw, pitch;
    public GameObject bulletPrefab;
    public Transform firePoint;

    void Start() => cc = GetComponent<CharacterController>();

    void Update() {
        Vector3 input = new Vector3(Input.GetAxis("Horizontal"), 0, Input.GetAxis("Vertical"));
        cc.Move(transform.TransformDirection(input) * speed * Time.deltaTime);
        yaw += lookSpeed * Input.GetAxis("Mouse X");
        pitch = Mathf.Clamp(pitch - lookSpeed * Input.GetAxis("Mouse Y"), -45, 60);
        transform.localRotation = Quaternion.Euler(0, yaw, 0);
        Camera.main.transform.localEulerAngles = new Vector3(pitch, 0, 0);

        if (Input.GetButtonDown("Fire1"))
            Instantiate(bulletPrefab, firePoint.position, firePoint.rotation);
    }
}using UnityEngine;
