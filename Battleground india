using UnityEngine.UI;
using System.Collections.Generic;

public class SkinManager : MonoBehaviour {
    public List<SkinData> skins;
    public Transform skinPanel;
    public GameObject skinButtonPrefab;
    public PlayerNetwork localPlayer;

    void Start() {
        foreach (var skin in skins) {
            GameObject btn = Instantiate(skinButtonPrefab, skinPanel);
            btn.GetComponentInChildren<Text>().text = $"{skin.skinName} ({skin.cost}D)";
            btn.GetComponent<Button>().onClick.AddListener(() => EquipSkin(skin));
        }
    }

    void EquipSkin(SkinData skin) {
        localPlayer.EquipGun(skin.gunPrefab);
    }
}using UnityEngine;

[System.Serializable]
public class SkinData {
    public string skinName;
    public int cost;
    public GameObject gunPrefab;
}
